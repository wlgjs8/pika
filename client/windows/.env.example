# 이 파일을 같은 폴더의 .env 로 복사한 뒤 필요한 값만 바꾸세요.
# SSH 비밀번호는 저장하지 않습니다. setup_ssh_key.ps1을 최초 한 번 실행합니다.
PIKA_HOST=172.28.61.4
PIKA_SSH_USER=plaif
PIKA_SSH_PORT=22
PIKA_SSH_KEY=~\.ssh\id_ed25519_pika

PIKA_REMOTE_DIR=/home/plaif/workspace/pika
PIKA_LOCAL_PREVIEW_PORT=8765
PIKA_REMOTE_PREVIEW_PORT=8765

# Wi-Fi 권장 기본값. 끊김이 있으면 FPS를 5로 낮추세요.
PIKA_PREVIEW_FPS=10
PIKA_PREVIEW_TILE_WIDTH=320
PIKA_PREVIEW_JPEG_QUALITY=70
